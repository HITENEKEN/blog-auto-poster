{
  "name": "blog-auto-poster",
  "version": "1.0.0",
  "description": "Automated blog posting system for affiliate marketing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "cli": "node -r ./scripts/path-alias.js dist/cli/index.js",
    "dev": "ts-node -r tsconfig-paths/register src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node -r ./scripts/path-alias.js dist/cli/index.js research 테스트 --limit=3",
    "config:wizard": "npm run cli -- config"
  },
  "keywords": [
    "blog",
    "auto-poster",
    "affiliate",
    "coupang",
    "tistory",
    "wordpress",
    "youtube-shorts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@google/generative-ai": "^0.15.0",
    "axios": "^1.7.2",
    "better-sqlite3": "^9.6.0",
    "bottleneck": "^2.19.5",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "form-data": "^4.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^14.1.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "openai": "^4.52.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "rss-parser": "^3.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cheerio": "^0.22.35",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitest/coverage-v8": "^2.0.4",
    "eslint": "^9.7.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
