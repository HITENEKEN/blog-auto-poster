{
  "name": "blog-auto-poster",
  "version": "1.0.0",
  "description": "Automated blog posting system for affiliate marketing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:platforms": "tsc -p tsconfig.platforms.json",
    "cli": "node -r ./scripts/path-alias.js dist/cli/index.js",
    "dev": "ts-node -r tsconfig-paths/register src/cli/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "naver:login": "node scripts/naver-login.mjs",
    "smoke": "node -r ./scripts/path-alias.js dist/cli/index.js research 테스트 --limit=3",
    "pretest:e2e": "npm run build && cd src/web/client && npx vite build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "blog",
    "auto-poster",
    "affiliate",
    "coupang",
    "tistory",
    "wordpress",
    "youtube-shorts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@google/generative-ai": "^0.15.0",
    "axios": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "bottleneck": "^2.19.5",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "form-data": "^4.0.0",
    "handlebars": "^4.7.8",
    "inquirer": "^14.1.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "openai": "^4.52.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "playwright": "^1.62.1",
    "rss-parser": "^3.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cheerio": "^0.22.35",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.0.4",
    "eslint": "^9.7.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
