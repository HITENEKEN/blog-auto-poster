---
name: "coupang-product-review"
platforms: ["tistory", "wordpress", "naver"]
requiredFields:
  - "productName"
  - "price"
  - "pros"
  - "cons"
  - "affiliateUrl"
optionalFields:
  - "originalPrice"
  - "discountRate"
  - "rating"
  - "reviewCount"
  - "imageUrl"
  - "brand"
  - "categoryName"
  - "description"
  - "specs"
  - "topPosts"
  - "keywordInsight"
  - "experienceIntro"
  - "realUsageStory"
  - "whyIChoseIt"
  - "conclusion"
  - "usageTips"
  - "buyingChecklist"
seo:
  titleTemplate: "{{productName}} 리뷰 - 장단점 총정리 (2024)"
  descriptionTemplate: "{{productName}} 구매 전 꼭 확인하세요. 가격 {{price}}원, {{#if originalPrice}}정가 {{originalPrice}}원 ({{discountRate}}% 할인){{/if}}. 장점: {{#each pros}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}. 단점: {{#each cons}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}."
  keywords: ["{{productName}}", "리뷰", "추천", "가성비", "후기", "{{categoryName}}"]
jsonLd:
  type: "Product"
  includeReview: true
  includeAggregateRating: true
---

<div class="coupang-product-review">
<div class="disclosure" style="font-size:.85rem;color:#868e96;margin:0 0 16px;">
  이 포스트는 쿠팡 파트너스 활동의 일환으로, 일정액의 수수료를 제공받을 수 있습니다.
</div>

  <!-- Product Header -->
  <div class="product-header">
    {{#if imageUrl}}
    <figure class="product-image">
      <img src="{{imageUrl}}" alt="{{productName}} 제품 이미지" loading="lazy" />
    </figure>
    {{/if}}
    <div class="product-info">
      <h1>{{productName}}</h1>
      {{#if brand}}
      <p class="brand">{{brand}}</p>
      {{/if}}
      {{#if categoryName}}
      <p class="category">{{categoryName}}</p>
      {{/if}}
      <div class="price-section">
        <span class="current-price">{{formatPrice price}}원</span>
        {{#if originalPrice}}
        <span class="original-price">{{formatPrice originalPrice}}원</span>
        <span class="discount-badge">{{discountRate}}% 할인</span>
        {{/if}}
      </div>
      {{#if rating}}
      <div class="rating">
        <span class="stars">{{renderStars rating}}</span>
        <span class="review-count">({{reviewCount}}개 리뷰)</span>
      </div>
      {{/if}}
      <div class="cta-button-wrapper">
        <a href="{{affiliateUrl}}" target="_blank" rel="nofollow sponsored" class="cta-button">
          최저가 확인하기 →
        </a>
      </div>
    </div>
  </div>

  <!-- First-person experience intro (LLM-generated; falls back to header copy) -->
  {{#if experienceIntro}}
  <section class="experience-intro">
    <p>{{experienceIntro}}</p>
  </section>
  {{/if}}

  <!-- Quick Summary -->
  <section class="quick-summary">
    <h2>한눈에 보는 요약</h2>
    <div class="summary-grid">
      <div class="summary-item pros">
        <h3>✅ 장점</h3>
        <ul>
          {{#each pros}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      <div class="summary-item cons">
        <h3>❌ 단점</h3>
        <ul>
          {{#each cons}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </section>

  <!-- Detailed Review (first-person) -->
  <section class="detailed-review">
    <h2>제가 직접 써본 상세 후기</h2>

    {{#if realUsageStory}}
    <div class="real-usage">
      <p>{{realUsageStory}}</p>
    </div>
    {{else}}
      {{#if description}}
      <div class="description">
        <h3>제품 설명</h3>
        <p>{{description}}</p>
      </div>
      {{/if}}
    {{/if}}

    {{#if specs}}
    <div class="specs">
      <h3>주요 스펙</h3>
      <table>
        <thead>
          <tr><th>항목</th><th>내용</th></tr>
        </thead>
        <tbody>
          {{#each specs}}
          <tr><td>{{@key}}</td><td>{{this}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}

    <div class="pros-section">
      <h3>장점 상세</h3>
      <ul>
        {{#each pros}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="cons-section">
      <h3>단점 상세</h3>
      <ul>
        {{#each cons}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>

    {{#if whyIChoseIt}}
    <div class="why-chose">
      <h3>왜 이 제품을 골랐는지</h3>
      <p>{{whyIChoseIt}}</p>
    </div>
    {{/if}}
  </section>

  <!-- Keyword insight: SCH_TRND trend + SHPP_INST shopping clicks (optional) -->
  {{#if keywordInsight}}
  <section class="keyword-insight">
    <h2>요즘 {{categoryName}} 인기 추이</h2>
    <p>"{{keywordInsight.keyword}}" 검색 관심은 최근 {{keywordInsight.trendLabel}}예요.</p>
    {{#if keywordInsight.shoppingCategory}}<p>쇼핑 분야: {{keywordInsight.shoppingCategory.name}} (클릭 추이 점수 {{keywordInsight.shoppingRatio}})</p>{{/if}}
    {{#if keywordInsight.relatedKeywords.length}}
    <p>함께 많이 찾는 키워드: {{#each keywordInsight.relatedKeywords}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
    {{/if}}
  </section>
  {{/if}}

  <!-- Benchmark section: top-ranking Naver blog posts (optional) -->
  {{#if topPosts}}
  <section class="benchmarks">
    <h2>다른 분들은 이렇게 쓰셨더라고요</h2>
    <ul>
      {{#each topPosts}}
      <li><a href="{{this.link}}" target="_blank" rel="noopener">{{this.title}}</a> — {{this.bloggername}}</li>
      {{/each}}
    </ul>
    <p>상위 블로그들을 벤치마킹해 보니 공통적으로 강조하는 포인트는 실사용 편의성과 가성비였습니다. 저도 써보고 나서 그 말에 충분히 공감했습니다.</p>
  </section>
  {{/if}}

  <!-- Practical usage tips + buying checklist (LLM-generated) -->
  {{#if usageTips}}
  <section class="tips-section">
    <h2>실전 활용 팁</h2>
    <ul>
      {{#each usageTips}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  {{#if buyingChecklist}}
  <section class="checklist-section">
    <h2>구매 전 체크리스트</h2>
    <ul>
      {{#each buyingChecklist}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <!-- Purchase Guide -->
  <section class="purchase-guide">
    <h2>구매 가이드</h2>
    <p>
      {{productName}}은(는) {{#if discountRate}}현재 {{discountRate}}% 할인된 {{formatPrice price}}원에 구매 가능합니다.{{else}}{{formatPrice price}}원에 판매 중입니다.{{/if}}
      {{#if originalPrice}}정가 {{formatPrice originalPrice}}원에서 할인된 가격입니다.{{/if}}
    </p>
    {{#if conclusion}}
    <div class="conclusion">
      <p>{{conclusion}}</p>
    </div>
    {{/if}}
    <div class="purchase-cta">
      <a href="{{affiliateUrl}}" target="_blank" rel="nofollow sponsored" class="purchase-button">
        🛒 쿠팡에서 최저가 확인하기
      </a>
    </div>
    <p class="disclaimer">
      <small>
        ※ 이 링크는 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
      </small>
    </p>
  </section>

  <!-- Related Products Placeholder -->
  <section class="related-products">
    <h2>함께 보면 좋은 제품</h2>
    <p>관련 제품 추천 영역입니다. (향후 구현 예정)</p>
  </section>
</div>

<style>
.coupang-product-review {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  line-height: 1.7;
  color: #333;
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
}
.product-header {
  display: flex;
  gap: 24px;
  margin-bottom: 32px;
  padding-bottom: 24px;
  border-bottom: 1px solid #eee;
}
.product-image img {
  max-width: 200px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.product-info h1 {
  font-size: 1.8rem;
  margin: 0 0 8px;
  color: #1a1a1a;
}
.brand { color: #666; font-size: 1rem; margin: 0 0 4px; }
.category { color: #888; font-size: 0.9rem; margin: 0 0 16px; }
.price-section { display: flex; align-items: baseline; gap: 12px; margin: 16px 0; }
.current-price { font-size: 1.5rem; font-weight: 700; color: #e53935; }
.original-price { font-size: 1rem; color: #999; text-decoration: line-through; }
.discount-badge { background: #e53935; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85rem; font-weight: 600; }
.rating { display: flex; align-items: center; gap: 8px; margin: 12px 0; }
.cta-button-wrapper { margin-top: 16px; }
.cta-button {
  display: inline-block;
  background: #e53935;
  color: white;
  padding: 14px 28px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 600;
  font-size: 1.1rem;
  transition: background 0.2s;
}
.cta-button:hover { background: #c62828; }
.experience-intro {
  margin: 24px 0;
  padding: 18px 20px;
  background: #f3f8ff;
  border-left: 4px solid #1e88e5;
  border-radius: 6px;
  font-size: 1.02rem;
  color: #1a3a5c;
}
.quick-summary { margin: 32px 0; padding: 20px; background: #fafafa; border-radius: 8px; }
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.summary-item h3 { font-size: 1.1rem; margin: 0 0 12px; }
.summary-item.pros h3 { color: #2e7d32; }
.summary-item.cons h3 { color: #c62828; }
.summary-item ul { margin: 0; padding-left: 20px; }
.summary-item li { margin: 8px 0; }
.detailed-review { margin: 32px 0; }
.detailed-review h2 { font-size: 1.5rem; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #e53935; }
.detailed-review h3 { font-size: 1.2rem; color: #333; margin-top: 24px; }
.real-usage { margin: 16px 0; padding: 16px; background: #fffef5; border: 1px solid #fff3c4; border-radius: 8px; }
.real-usage p { margin: 0; white-space: pre-line; }
.description p { color: #555; }
.specs table { width: 100%; border-collapse: collapse; margin: 12px 0; }
.specs th, .specs td { padding: 10px 12px; border: 1px solid #ddd; text-align: left; }
.specs th { background: #f5f5f5; font-weight: 600; }
.why-chose { margin-top: 20px; padding: 14px 16px; background: #f1f8e9; border-radius: 8px; }
.why-chose p { margin: 0; white-space: pre-line; }
.benchmarks { margin: 32px 0; padding: 20px; background: #f7f7fb; border: 1px solid #e0e0ef; border-radius: 8px; }
.benchmarks h2 { font-size: 1.3rem; margin: 0 0 12px; color: #4527a0; }
.benchmarks ul { margin: 0 0 12px; padding-left: 20px; }
.benchmarks li { margin: 6px 0; }
.benchmarks a { color: #4527a0; text-decoration: none; }
.benchmarks a:hover { text-decoration: underline; }
.purchase-guide { margin: 32px 0; padding: 24px; background: #fff8f8; border-radius: 8px; border: 1px solid #ffebee; }
.purchase-guide h2 { font-size: 1.4rem; margin: 0 0 16px; color: #c62828; }
.conclusion { margin: 14px 0; padding: 14px 16px; background: #e8f5e9; border-radius: 8px; }
.tips-section { margin: 32px 0; padding: 20px; background: #fffde7; border-radius: 8px; }
.tips-section h2 { font-size: 1.3rem; margin: 0 0 12px; color: #f57f17; }
.tips-section ul { margin: 0; padding-left: 20px; }
.tips-section li { margin: 8px 0; }
.checklist-section { margin: 32px 0; padding: 20px; background: #e8f5e9; border-radius: 8px; }
.checklist-section h2 { font-size: 1.3rem; margin: 0 0 12px; color: #2e7d32; }
.checklist-section ul { margin: 0; padding-left: 20px; list-style: none; }
.checklist-section li { margin: 8px 0; }
.checklist-section li::before { content: "☐ "; }
.conclusion p { margin: 0; white-space: pre-line; }
.purchase-button {
  display: inline-block;
  background: #2e7d32;
  color: white;
  padding: 16px 32px;
  border-radius: 6px;
  text-decoration: none;
  font-weight: 700;
  font-size: 1.1rem;
  margin: 16px 0;
  transition: background 0.2s;
}
.purchase-button:hover { background: #1b5e20; }
.disclaimer { margin-top: 16px; color: #888; font-size: 0.85rem; }
.related-products { margin-top: 40px; padding-top: 24px; border-top: 1px solid #eee; color: #888; }
@media (max-width: 600px) {
  .product-header { flex-direction: column; }
  .summary-grid { grid-template-columns: 1fr; }
}
</style>
