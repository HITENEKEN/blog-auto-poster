---
name: "naver-coupang-review-fun"
platforms: ["naver"]
requiredFields:
  - "productName"
  - "price"
  - "affiliateUrl"
  - "experienceIntro"
  - "realUsageStory"
  - "conclusion"
optionalFields:
  - "categoryName"
  - "brand"
  - "originalPrice"
  - "discountRate"
  - "rating"
  - "reviewCount"
  - "imageUrl"
  - "pros"
  - "cons"
  - "targetAudience"
  - "specs"
  - "faqList"
  - "keywordInsight"
  - "whyIChoseIt"
  - "usageTips"
  - "buyingChecklist"
seo:
  titleTemplate: "{{productName}} 개봉기 🎬 솔직 후기 (장단점 총정리)"
  descriptionTemplate: "{{productName}}을(를) 직접 사용해 본 1인칭 체험 후기입니다. 사용 환경, 소요 시간, 장단점과 구매 전 체크리스트까지 정리했습니다."
  keywords: ["{{productName}} 후기", "{{productName}} 리뷰", "{{productName}} 사용기", "{{productName}} 추천"]
jsonLd:
  type: "Product"
  includeReview: true
---

<div class="ncf-wrap">

  <!-- 광고 표기: 네이버 광고 지침상 제목 또는 본문 최상단 표기 의무 -->
  <div class="ncf-disclosure" role="note">
    <strong>광고</strong> · 이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.
  </div>

  <!-- 헤더 -->
  <div class="ncf-header">
    <h1>🎬 {{productName}} 개봉기 — 솔직 후기 드갑니다</h1>
    <p class="ncf-meta">
      {{#if categoryName}}<span>📂 {{categoryName}}</span>{{/if}}
      {{#if brand}}<span>🏷️ {{brand}}</span>{{/if}}
      {{#if rating}}<span>⭐ {{renderStars rating}} ({{reviewCount}}개 리뷰)</span>{{/if}}
    </p>
  </div>

  {{#if imageUrl}}
  <img src="{{imageUrl}}" alt="{{productName}}" class="ncf-img" loading="lazy" />
  {{/if}}

  <!-- 도입부 -->
  <div class="ncf-experience">✋ 잠깐, 구매 전에 3분만 내주세요. {{experienceIntro}}</div>

  <!-- 인사이트 -->
  {{#if keywordInsight}}
  <div class="ncf-section">
    <h2>📈 요즘 {{categoryName}} 실시간 분위기</h2>
    <p>"{{keywordInsight.keyword}}" 검색 관심은 최근 {{keywordInsight.trendLabel}}예요. 국룰대로 흐름 먼저 체크하고 갑니다 🏃</p>
    {{#if keywordInsight.shoppingCategory}}<p>쇼핑 분야: {{keywordInsight.shoppingCategory.name}} (클릭 추이 점수 {{keywordInsight.shoppingRatio}})</p>{{/if}}
    {{#if keywordInsight.relatedKeywords.length}}
    <p>함께 많이 찾는 키워드: {{#each keywordInsight.relatedKeywords}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
    {{/if}}
  </div>
  {{/if}}

  <!-- 상세 체험기 -->
  <div class="ncf-section">
    <h2>🔥 제가 직접 써본 솔직 이야기</h2>
    <p style="white-space:pre-line">{{realUsageStory}}</p>
  </div>

  {{#if sectionImages.usage}}
  <figure class="section-image">
    <img src="{{sectionImages.usage}}" alt="제가 직접 사용해 본 이야기" loading="lazy" />
    <figcaption>실사 컷 — 직접 찍었습니다 📸</figcaption>
  </figure>
  {{/if}}

  <!-- 장단점 -->
  {{#if pros}}
  <table class="ncf-pctable">
    <tr><th>✅ 좋았던 점 (갓산물)</th><th>❌ 아쉬웠던 점 (솔직하게)</th></tr>
    <tr>
      <td><ul>{{#each pros}}<li>👍 {{this}}</li>{{/each}}</ul></td>
      <td><ul>{{#each cons}}<li>😅 {{this}}</li>{{/each}}</ul></td>
    </tr>
  </table>
  {{/if}}

  <!-- 스펙 -->
  {{#if specs}}
  <div class="ncf-section">
    <h2>🧾 스펙 한눈에 보기</h2>
    <table class="ncf-specs">
      {{#each specs}}
      <tr><th>{{@key}}</th><td>{{this}}</td></tr>
      {{/each}}
    </table>
  </div>

  {{#if sectionImages.specs}}
  <figure class="section-image">
    <img src="{{sectionImages.specs}}" alt="주요 스펙" loading="lazy" />
    <figcaption>스펙 디테일 컷 🔍</figcaption>
  </figure>
  {{/if}}
  {{/if}}

  <!-- 제휴 링크: 본문 중단 단 1개 CTA -->
  <div class="ncf-price-card">
    <span class="ncf-price">💰 {{formatPrice price}}원</span>
    {{#if originalPrice}}<span class="ncf-original">{{formatPrice originalPrice}}원</span>{{/if}}
    {{#if discountRate}}<span class="ncf-discount">🔥 {{discountRate}}% 할인</span>{{/if}}
    <a href="{{affiliateUrl}}" target="_blank" rel="nofollow sponsored" class="ncf-cta">🛒 {{productName}} 최저가 확인하기</a>
  </div>

  <!-- 선택 이유 -->
  {{#if whyIChoseIt}}
  <div class="ncf-section">
    <h2>🤔 왜 하필 이 제품이었나</h2>
    <p style="white-space:pre-line">{{whyIChoseIt}}</p>
  </div>
  {{/if}}

  <!-- 실전 활용 팁 -->
  {{#if usageTips}}
  <div class="ncf-section">
    <h2>💡 꿀팁 (이건 저장 각)</h2>
    <ul class="ncf-tips">
      {{#each usageTips}}<li>🍯 {{this}}</li>{{/each}}
    </ul>
  </div>

  {{#if sectionImages.tips}}
  <figure class="section-image">
    <img src="{{sectionImages.tips}}" alt="실전 활용 팁" loading="lazy" />
    <figcaption>활용 팁 관련 컷 ✌️</figcaption>
  </figure>
  {{/if}}
  {{/if}}

  <!-- 구매 전 체크리스트 -->
  {{#if buyingChecklist}}
  <div class="ncf-section">
    <h2>📝 주문 전 5초 체크리스트</h2>
    <ul class="ncf-checklist">
      {{#each buyingChecklist}}<li>☑️ {{this}}</li>{{/each}}
    </ul>
  </div>
  {{/if}}

  <!-- FAQ -->
  {{#if faqList}}
  <div class="ncf-section">
    <h2>💬 자주 묻는 질문 (실시간 Q&A)</h2>
    {{#each faqList}}
    <p class="ncf-faq-q">Q. {{this.question}}</p>
    <p class="ncf-faq-a">A. {{this.answer}}</p>
    {{/each}}
  </div>
  {{/if}}

  <!-- 추천 대상 -->
  {{#if targetAudience}}
  <div class="ncf-section">
    <h2>🎯 이런 분들께 추천 (나만 해당? 아님)</h2>
    <ul class="ncf-audience">
      {{#each targetAudience}}<li>👉 {{this}}</li>{{/each}}
    </ul>
  </div>
  {{/if}}

  <!-- 결론 -->
  <div class="ncf-section ncf-conclusion">
    <h2>🏁 총평 — 결국 사도 됩니까?</h2>
    <p style="white-space:pre-line">{{conclusion}}</p>
  </div>

</div>

<style>
.ncf-wrap{max-width:760px;margin:0 auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans KR',sans-serif;font-size:1.05rem;line-height:2.0;color:#333;padding:16px}
.ncf-section p{margin:0 0 16px}
.ncf-disclosure{background:#fff3bf;border:1px solid #ffd43b;border-radius:8px;padding:12px 16px;font-size:14px;color:#5c4400;margin-bottom:20px}
.ncf-header h1{font-size:1.5rem;line-height:1.4;margin:0 0 8px;color:#212529}
.ncf-meta{color:#868e96;font-size:.85rem;margin:0 0 16px}
.ncf-meta span{margin-right:10px}
.ncf-img{max-width:100%;border-radius:8px;margin:0 0 16px}
.ncf-experience{background:#fff0f6;border-left:5px solid #e64980;border-radius:0 8px 8px 0;padding:16px 20px;font-size:1.05rem;color:#4a1d33;margin-bottom:20px}
.ncf-section{margin:0 0 28px}
.ncf-section h2{font-size:1.3rem;margin:0 0 14px;color:#212529;background:#fff0f6;border-left:4px solid #e64980;padding:8px 12px;border-radius:0 6px 6px 0}
.ncf-pctable{width:100%;border-collapse:collapse;margin:0 0 24px}
.ncf-pctable th{background:#e64980;color:#fff;padding:10px;font-size:.95rem}
.ncf-pctable td{border:1px solid #f1dfe6;padding:12px;vertical-align:top;font-size:.95rem;width:50%}
.ncf-pctable ul{margin:0;padding-left:18px}
.ncf-pctable li{margin-bottom:8px}
.ncf-specs{width:100%;border-collapse:collapse;margin:0 0 24px}
.ncf-specs th{background:#f8f9fa;border:1px solid #e9ecef;padding:8px 12px;width:35%;text-align:left;font-size:.9rem}
.ncf-specs td{border:1px solid #e9ecef;padding:8px 12px;font-size:.92rem}
.ncf-price-card{background:#fff5f8;border:2px solid #e64980;border-radius:12px;padding:18px 20px;text-align:center;margin:28px 0}
.ncf-price{font-size:1.3rem;font-weight:700;color:#d6336c;margin-right:8px}
.ncf-original{text-decoration:line-through;color:#adb5bd;margin-right:8px;font-size:.95rem}
.ncf-discount{color:#e8590c;font-weight:600;font-size:.95rem}
.ncf-cta{display:inline-block;background:linear-gradient(135deg,#e64980,#f76707);color:#fff;padding:12px 28px;border-radius:24px;text-decoration:none;font-size:1rem;font-weight:700;margin-top:12px}
.ncf-tips{background:#fff9db;border-radius:8px;padding:14px 16px;list-style:none}
.ncf-tips li{margin-bottom:10px;font-size:.98rem}
.ncf-checklist{background:#ebfbee;border-radius:8px;padding:14px 16px;list-style:none}
.ncf-checklist li{margin-bottom:10px;font-size:.98rem}
.ncf-faq-q{font-weight:600;margin-bottom:4px}
.ncf-faq-a{color:#495057;font-size:.93rem;margin-bottom:14px}
.ncf-audience{background:#e7f5ff;border-radius:8px;padding:14px 16px;list-style:none}
.ncf-audience li{margin-bottom:10px;font-size:.98rem}
.section-image{margin:28px 0}
.section-image img{display:block;max-width:100%;border-radius:10px;box-shadow:0 4px 14px rgba(0,0,0,.12);margin:0 auto}
.section-image figcaption{margin-top:10px;font-size:.88rem;color:#868e96;text-align:center}
</style>
